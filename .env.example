# Copy to .env.local — gitignored by the `*.local` rule, so it can't be committed.

# --- Assistant ---
# console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=sk-ant-...

# --- Slack (multi-workspace OAuth) ---
# api.slack.com/apps -> your app -> Basic Information -> App Credentials
SLACK_CLIENT_ID=1234567890.1234567890
SLACK_CLIENT_SECRET=...
# Must EXACTLY match a Redirect URL registered under OAuth & Permissions.
# Slack requires HTTPS, so localhost needs a tunnel (ngrok / cloudflared).
SLACK_REDIRECT_URI=https://your-tunnel.ngrok-free.app/api/slack/callback

# --- Meta ads (Settings -> Data source -> Connect Meta) ---
# developers.facebook.com/apps -> your app -> App settings -> Basic
META_CLIENT_ID=
META_CLIENT_SECRET=
# Optional. Defaults to v25.0 (current Marketing API, Oct 2026).
# META_API_VERSION=v25.0

# --- Google Ads (Settings -> Data source -> Connect Google Ads) ---
# console.cloud.google.com -> APIs & Services -> Credentials -> OAuth client (Web application)
# Redirect URI: http://localhost:5173/api/connect/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# No developer token: Google retired them Sept 9, 2026. Access is the Cloud
# project's level (Test -> Explorer -> Basic). Optional and ignored if set:
# GOOGLE_ADS_DEVELOPER_TOKEN=
# GOOGLE_ADS_API_VERSION=v25
